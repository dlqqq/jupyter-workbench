root := justfile_directory()

# Create a new workspace (scaffold only; provision with `just ws spawn <name>`)
[no-cd]
[arg("name", help="workspace name")]
create name:
    #!/usr/bin/env bash
    set -eo pipefail
    root="{{ root }}"
    cd "$root"

    name="{{ name }}"

    ws="$root/workspaces/$name"
    if [[ -d "$ws" ]]; then
        echo "Error: workspace '$name' already exists at $ws" >&2
        exit 1
    fi

    # Create workspace as a git worktree with a dated branch
    branch="$(date +%Y%m%d)-$name"
    git worktree add -b "$branch" "$ws"

    # Generate pyproject.toml with the workspace name as the venv/project name
    sed "s/^name = .*/name = \"$name\"/" "$root/workspaces/templates/pyproject.toml" > "$ws/pyproject.toml"

    # Create an empty venv so the workspace is immediately activatable
    # (`dev setup`'s `uv sync` later reuses it). Fast: no packages installed.
    (cd "$ws" && uv venv >/dev/null)

    # Symlink all repos into workspace repos/ for read-only context
    mkdir -p "$ws/repos"
    while IFS= read -r rname; do
        if [[ -d "$root/repos/$rname" ]]; then
            ln -sf "$root/repos/$rname" "$ws/repos/$rname"
        fi
    done < <(jq -r 'keys[]' "$root/repos.json")

    # Seed tmp/ with sample notebooks (the server is rooted in tmp/, so these
    # show up in the file browser as ready-to-use scratch notebooks)
    mkdir -p "$ws/tmp"
    if [[ -d "$root/workspaces/.sample-notebooks" ]]; then
        cp -R "$root/workspaces/.sample-notebooks/." "$ws/tmp/"
    fi

    # Write runtime-only workspace info
    jq -n '{"server": null, "browser": null, "agent": null}' > "$ws/.workspace_info.json"

    # Copy .env if present
    [[ -f "$root/.env" ]] && cp "$root/.env" "$ws/.env"

    # Open in cmux if available, otherwise print instructions. In both cases the
    # venv is activated first (it was created by `uv venv` above). Provisioning is
    # deliberately NOT run here — `ws create` only scaffolds. Write a setup.sh
    # and PROMPT.md into the workspace, then run `just ws spawn <name>`. Keeping
    # scaffold and provisioning separate means: (1) no free-form command crosses
    # a shell-quoting boundary — setup.sh is a file; (2) no race between writing
    # PROMPT.md and the agent reading it; (3) provisioning is re-runnable on failure.
    if [[ -n "${CMUX_WORKSPACE_ID:-}" ]]; then
        # --command sends text+Enter to the new workspace's terminal, so the
        # activation persists in the interactive shell.
        cmux_ws=$(cmux new-workspace --name "[ws] $name" --cwd "$ws" --command "source .venv/bin/activate")
        echo "✓ Opened cmux workspace: $cmux_ws"
    else
        echo ""
        echo "in a new terminal, run"
        echo ""
        echo "cd workspaces/$name"
        echo "source .venv/bin/activate"
        echo "just dev setup"
        echo ""
    fi

    echo "✓ Workspace '$name' created at: $ws"
    echo "✓ Branch: $branch"
    echo "→ Next: write workspaces/$name/{setup.sh,PROMPT.md}, then run 'just ws spawn $name'"

# Provision + launch the agent by running the workspace's setup.sh (needs setup.sh + PROMPT.md)
[no-cd]
[arg("name", help="workspace name")]
spawn name:
    #!/usr/bin/env bash
    set -eo pipefail
    root="{{ root }}"
    name="{{ name }}"
    ws="$root/workspaces/$name"

    if [[ ! -d "$ws" ]]; then
        echo "Error: workspace '$name' not found at $ws" >&2
        exit 1
    fi
    # Require both handoff files up front — fail fast before touching cmux.
    for f in setup.sh PROMPT.md; do
        if [[ ! -f "$ws/$f" ]]; then
            echo "Error: no $f in workspace '$name'." >&2
            echo "  Write $ws/$f first, then re-run 'just ws spawn $name'." >&2
            exit 1
        fi
    done

    # Hand off to the workspace's setup.sh — a file, so no command text is ever
    # passed through a flag. It provisions (dev add/setup) and ends by launching
    # the agent via `just ws _launch-agent`. In cmux, run it in the workspace's
    # own terminal so the agent lives in that interactive session.
    if [[ -n "${CMUX_WORKSPACE_ID:-}" ]]; then
        ref=$(cmux list-workspaces --json | jq -r --arg t "[ws] $name" '.workspaces[] | select(.title == $t) | .ref' | head -1)
        if [[ -z "$ref" ]]; then
            echo "Error: no open cmux workspace titled '[ws] $name'." >&2
            echo "  Run 'just ws create $name' first (it opens the cmux workspace)." >&2
            exit 1
        fi
        # Trailing \n submits the line (cmux send does NOT append Enter on its own).
        cmux send --workspace "$ref" 'source .venv/bin/activate && bash setup.sh\n'
        echo "✓ Sent setup.sh to cmux workspace '$ref' ([ws] $name)"
    else
        cd "$ws"
        source .venv/bin/activate
        bash setup.sh
    fi

# Launch the agent CLI (workbench-config.json's agent-cmd) with PROMPT.md as its
# prompt. Runs INSIDE the workspace, invoked by setup.sh — not for direct use.
[no-cd]
[private]
_launch-agent:
    #!/usr/bin/env bash
    set -eo pipefail

    # This runs from inside the workspace worktree, so the workspace root is the
    # git toplevel (justfile_directory() here would be the workbench workspaces/).
    ws=$(git rev-parse --show-toplevel)

    if [[ ! -f "$ws/PROMPT.md" ]]; then
        echo "Error: no PROMPT.md in this workspace ($ws)." >&2
        echo "  Write PROMPT.md (the agent's task + handoff context) first." >&2
        exit 1
    fi

    # The agent CLI is configured in workbench-config.json (tracked, so it's
    # present in every worktree). No fallback: a missing agent-cmd is a real bug.
    config="$ws/workbench-config.json"
    agent_cmd=$(jq -re '."agent-cmd"' "$config" 2>/dev/null) || {
        echo "Error: no \"agent-cmd\" in $config." >&2
        echo "  Define it, e.g. \"agent-cmd\": \"claude --permission-mode auto\"." >&2
        exit 1
    }

    # The prompt IS the file — free-form text goes to disk, never through a flag.
    # It's appended as the agent CLI's final positional argument (the prompt/INPUT).
    prompt=$(cat "$ws/PROMPT.md")

    pgid=$(ps -o pgid= -p $$ | tr -d ' ')
    jq --arg pgid "$pgid" '.agent = {"pgid": ($pgid | tonumber)}' \
        "$ws/.workspace_info.json" > "$ws/.workspace_info.json.tmp" \
        && mv "$ws/.workspace_info.json.tmp" "$ws/.workspace_info.json"
    source "$ws/.venv/bin/activate"

    # Word-split agent-cmd into command + flags, then append the prompt as one arg.
    read -ra agent_argv <<< "$agent_cmd"
    exec "${agent_argv[@]}" "$prompt"

# Reset a workspace's worktree branch onto the latest workbench main
[no-cd]
[arg("name", help="workspace name (defaults to the current directory)")]
rebase name="":
    #!/usr/bin/env bash
    set -eo pipefail
    name="{{ name }}"

    # Resolve the workbench root from git (this recipe runs from inside a
    # workspace, where justfile_directory() would be the workspace itself).
    wb=$(git rev-parse --path-format=absolute --git-common-dir | xargs dirname)

    # Default to the invocation directory's workspace
    [[ -z "$name" ]] && name=$(basename "$(pwd)")
    ws="$wb/workspaces/$name"
    if [[ ! -d "$ws" ]]; then
        echo "Error: workspace '$name' not found at $ws" >&2
        exit 1
    fi

    # 1. Refuse on uncommitted tracked changes (untracked files survive the
    #    branch switch, so they don't block — listed as an FYI).
    dirty=$(git -C "$ws" status --porcelain --untracked-files=no)
    if [[ -n "$dirty" ]]; then
        echo -e "\033[1;31mAborting: workspace '$name' has uncommitted changes.\033[0m" >&2
        echo "$dirty" >&2
        echo "Commit, stash, or discard them, then run 'just ws rebase' again." >&2
        exit 1
    fi

    # 2. Fetch the latest main from the remote it tracks (fallback: first remote).
    remote=$(git -C "$ws" config branch.main.remote 2>/dev/null || true)
    [[ -z "$remote" ]] && remote=$(git -C "$ws" remote | head -1)
    git -C "$ws" fetch "$remote"

    # 3. Safety: a squash-merge collapses the branch's commits into one, so a
    #    commit-based "ahead" check would false-positive. Compare TREES instead —
    #    if the worktree's content already matches main, all its work has landed
    #    and the reset is safe. Otherwise there's un-landed content; abort.
    if ! git -C "$ws" diff --quiet "$remote/main" HEAD; then
        echo -e "\033[1;31mAborting: '$name' has changes not in $remote/main.\033[0m" >&2
        git -C "$ws" diff --stat "$remote/main" HEAD >&2
        echo "Land these (open + merge a PR) before rebasing, or discard them." >&2
        exit 1
    fi

    # 4. Reset the worktree onto a fresh dated branch off main.
    oldbranch=$(git -C "$ws" rev-parse --abbrev-ref HEAD)
    newbranch="$(date +%Y%m%d)-$name"
    if git -C "$ws" show-ref --verify --quiet "refs/heads/$newbranch"; then
        newbranch="$newbranch-$(date +%H%M%S)"
    fi
    git -C "$ws" switch -c "$newbranch" "$remote/main"

    # 5. Delete the old branch (we've switched away from it).
    [[ "$oldbranch" != "$newbranch" ]] && git -C "$ws" branch -D "$oldbranch" 2>/dev/null || true

    echo "✓ '$name' reset onto '$newbranch' (off $remote/main); was '$oldbranch'"

# Remove a workspace (fast: instant rename + background delete)
[no-cd]
rm name:
    #!/usr/bin/env bash
    set -eo pipefail
    root="{{ root }}"
    name="{{ name }}"
    if [[ ! -d "$root/workspaces/$name" ]]; then
        echo "Error: workspace '$name' not found" >&2
        exit 1
    fi
    just ws _trash "$name"
    just ws _sweep
    echo "✓ Removed workspace '$name'; cleanup running in background"

# Instant-move a workspace to trash, prune its worktree registration, delete its branch
[no-cd]
[private]
_trash name:
    #!/usr/bin/env bash
    set -eo pipefail
    root="{{ root }}"
    name="{{ name }}"
    ws="$root/workspaces/$name"

    # Stop server + agent if running
    for key in server agent; do
        pgid=$(jq -r --arg k "$key" '.[$k].pgid // empty' "$ws/.workspace_info.json" 2>/dev/null || true)
        [[ -n "$pgid" ]] && kill -TERM -- -"$pgid" 2>/dev/null || true
    done

    # Capture the branch, then instant-move to trash (same volume → O(1))
    branch=$(git -C "$ws" rev-parse --abbrev-ref HEAD 2>/dev/null || true)
    trash="$root/workspaces/.trash"
    mkdir -p "$trash"
    mv "$ws" "$trash/$name-$(date +%s)-$$"

    # Prune the now-stale workbench worktree registration + delete the branch
    git -C "$root" worktree prune
    [[ -n "$branch" && "$branch" != "HEAD" ]] && git -C "$root" branch -D "$branch" 2>/dev/null || true
    echo "✓ Trashed workspace '$name' (branch: ${branch:-none})"

# Background-delete the trash dir, then prune dev/tmp worktrees from source repos
[no-cd]
[private]
_sweep:
    #!/usr/bin/env bash
    set -eo pipefail
    root="{{ root }}"
    trash="$root/workspaces/.trash"
    [[ -d "$trash" ]] || exit 0
    nohup bash -c "
        rm -rf '$trash'/* 2>/dev/null || true
        for r in '$root'/repos/*/; do
            [ -e \"\$r/.git\" ] && git -C \"\$r\" worktree prune 2>/dev/null || true
        done
    " >/dev/null 2>&1 &
    disown 2>/dev/null || true

# Delete all workspaces not currently open in cmux
[no-cd]
cleanup:
    #!/usr/bin/env bash
    set -eo pipefail
    root="{{ root }}"

    if [[ -z "${CMUX_WORKSPACE_ID:-}" ]]; then
        echo "Error: cleanup requires cmux (it determines which workspaces are open)." >&2
        exit 1
    fi

    # Get names of open cmux workspaces
    open_ws=()
    while IFS= read -r title; do
        if [[ "$title" == "[ws] "* ]]; then
            open_ws+=("${title#\[ws\] }")
        fi
    done < <(cmux list-workspaces --json | jq -r '.workspaces[].title')

    # Find workspaces not open in cmux
    ws_to_delete=()
    for ws in "$root"/workspaces/*/; do
        [[ -d "$ws" ]] || continue
        name=$(basename "$ws")
        [[ "$name" == "templates" || "$name" == ".trash" ]] && continue
        found=false
        for open in "${open_ws[@]}"; do
            [[ "$name" == "$open" ]] && found=true && break
        done
        [[ "$found" == "false" ]] && ws_to_delete+=("$name")
    done

    if [[ ${#ws_to_delete[@]} -eq 0 ]]; then
        echo "Nothing to clean up."
        exit 0
    fi

    echo -e "\033[1;33mWARNING: This will delete all workspaces not currently open in cmux.\033[0m"
    echo ""
    echo "Workspaces to delete:"
    for name in "${ws_to_delete[@]}"; do
        echo "├── $name"
    done
    echo ""

    read -p "Continue? [y/N] " answer
    if [[ ! "$answer" =~ ^[Yy] ]]; then
        echo "Cancelled."
        exit 0
    fi

    # Instant-trash each workspace, then one background sweep
    for name in "${ws_to_delete[@]}"; do
        just ws _trash "$name"
    done
    just ws _sweep
    echo "✓ Removed ${#ws_to_delete[@]} workspace(s); cleanup running in background"
