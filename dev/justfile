root := justfile_directory()

# Dev-install repos (comma-separated: create worktree under dev/, add as editable member, NO sync)
[no-cd]
add repos:
    #!/usr/bin/env bash
    set -eo pipefail
    root="{{ root }}"
    cd "$root"

    wb_repos="$(git rev-parse --path-format=absolute --git-common-dir | sed 's|/\.git$||')/repos"

    IFS=',' read -ra repo_list <<< "{{ repos }}"
    for repo in "${repo_list[@]}"; do
    repo_name="${repo%%#*}"
    pr_number="${repo#*#}"
    [[ "$pr_number" == "$repo" ]] && pr_number=""

    url=$(jq -r --arg r "$repo_name" '.[$r].url // empty' "$root/repos.json")
    if [[ -z "$url" ]]; then
        echo "Error: '$repo_name' not found in repos.json" >&2
        echo "Available repos: $(jq -r 'keys[]' "$root/repos.json" | tr '\n' ' ')" >&2
        exit 1
    fi
    if [[ -d "dev/$repo_name" ]]; then
        echo "Error: '$repo_name' already dev-installed" >&2
        exit 1
    fi

    # Ensure source repo exists at workbench root
    if [[ ! -d "$wb_repos/$repo_name" ]]; then
        echo "Cloning $repo_name into workbench repos/..."
        git clone "$url" "$wb_repos/$repo_name"
    fi

    # Create worktree under dev/
    mkdir -p dev
    ws_name=$(basename "$root")
    branch="$(date +%Y%m%d)-$ws_name/$repo_name"
    # Clean up any stale branch left by a prior (possibly failed) add so the
    # worktree branch name is free.
    git -C "$wb_repos/$repo_name" branch -D "$branch" 2>/dev/null || true
    echo "Creating worktree: dev/$repo_name (branch: $branch)..."
    git -C "$wb_repos/$repo_name" worktree add "$root/dev/$repo_name" -b "$branch"

    # Checkout PR if specified
    if [[ -n "$pr_number" ]]; then
        echo "Checking out PR #$pr_number..."
        # Land the PR on our workspace-scoped branch (not the PR's shared head
        # branch name), so the same PR can be dev-added in multiple workspaces
        # without "branch already used by worktree" collisions on the shared repo.
        (cd "dev/$repo_name" && gh pr checkout "$pr_number" --branch "$branch" --force)
        pr_info=$(cd "dev/$repo_name" && gh pr view "$pr_number" --json headRepositoryOwner,headRepository)
        pr_author=$(echo "$pr_info" | jq -r '.headRepositoryOwner.login')
        pr_repo=$(echo "$pr_info" | jq -r '.headRepository.name')
        fork_url="git@github.com:$pr_author/$pr_repo.git"
        (cd "dev/$repo_name" && git remote add "$pr_author" "$fork_url" 2>/dev/null || true)
        echo "Added remote '$pr_author' → $fork_url"
    fi

    # Add as editable workspace member(s) WITHOUT syncing
    pkg_parents=$(jq -r --arg r "$repo_name" '
        .[$r].packages // [{"parentDir": "."}]
        | .[].parentDir
    ' "$root/repos.json")

    while IFS= read -r parent_dir; do
        uv add "./dev/$repo_name/$parent_dir" --workspace --editable --no-sync
    done <<< "$pkg_parents"

    echo "✓ Added: dev/$repo_name (run 'just dev setup' to install)"
    done

# Remove a dev-installed repo (remove worktree + pyproject member)
[no-cd]
remove repo_name:
    #!/usr/bin/env bash
    set -eo pipefail
    root="{{ root }}"
    repo_name="{{ repo_name }}"
    cd "$root"

    if [[ ! -d "$root/dev/$repo_name" ]]; then
        echo "Error: '$repo_name' is not dev-installed" >&2
        exit 1
    fi

    # Remove dependency + source entries without syncing
    pkg_names=$(jq -r --arg r "$repo_name" '
        .[$r].packages // [{"name": ($r | gsub("-";"_"))}]
        | .[].name
    ' "$root/repos.json")
    while IFS= read -r pkg_name; do
        [[ -n "$pkg_name" ]] || continue
        uv remove "$pkg_name" --no-sync 2>/dev/null || true
    done <<< "$pkg_names"

    # Strip the workspace member path(s) for this repo from pyproject.toml
    # (uv remove leaves [tool.uv.workspace] members; a dangling path breaks uv sync).
    # Match "dev/<repo>" exactly or "dev/<repo>/..." (not "dev/<repo>-other").
    sed -i.bak "\#\"dev/$repo_name[/\"]#d" pyproject.toml && rm -f pyproject.toml.bak

    # Capture the worktree's current branch (e.g. a PR branch) before removing it
    wb_repos="$(git rev-parse --path-format=absolute --git-common-dir | sed 's|/\.git$||')/repos"
    ws_name=$(basename "$root")
    cur_branch=$(git -C "$root/dev/$repo_name" rev-parse --abbrev-ref HEAD 2>/dev/null || true)

    # Remove the worktree
    git -C "$wb_repos/$repo_name" worktree remove "$root/dev/$repo_name" --force

    # Delete the branches this workspace created for this repo, so a same-day
    # re-add doesn't collide: the dated worktree branch(es) + the checked-out branch.
    while IFS= read -r b; do
        [[ -n "$b" ]] && git -C "$wb_repos/$repo_name" branch -D "$b" 2>/dev/null || true
    done < <(git -C "$wb_repos/$repo_name" branch --list "????????-$ws_name/$repo_name" --format='%(refname:short)' 2>/dev/null)
    [[ -n "$cur_branch" && "$cur_branch" != "HEAD" ]] && git -C "$wb_repos/$repo_name" branch -D "$cur_branch" 2>/dev/null || true

    echo "✓ Removed: dev/$repo_name"

# Enable extensions for a repo
[no-cd]
enable-extensions repo_name:
    #!/usr/bin/env bash
    set -eo pipefail
    root="{{ root }}"
    repo_name="{{ repo_name }}"

    # Server extensions
    pkg_names=$(jq -r --arg r "$repo_name" '
        .[$r].packages // [{"name": ($r | gsub("-";"_"))}]
        | .[].name
    ' "$root/repos.json")
    while IFS= read -r pkg_name; do
        [[ -n "$pkg_name" ]] || continue
        echo "Enabling server extension: $pkg_name"
        jupyter server extension enable "$pkg_name"
    done <<< "$pkg_names"

    # Lab extensions
    pkg_parents=$(jq -r --arg r "$repo_name" '
        .[$r].packages // [{"parentDir": "."}]
        | .[].parentDir
    ' "$root/repos.json")
    while IFS= read -r parent_dir; do
        [[ -n "$parent_dir" ]] || continue
        echo "Enabling lab extension in: dev/$repo_name/$parent_dir"
        (cd "$root/dev/$repo_name/$parent_dir" && jupyter labextension develop . --overwrite) || true
    done <<< "$pkg_parents"

# Enable extensions for all dev-installed repos (scans ./dev)
[no-cd]
enable-all-extensions:
    #!/usr/bin/env bash
    set -eo pipefail
    root="{{ root }}"
    for d in "$root"/dev/*/; do
        [[ -d "$d" ]] || continue
        repo=$(basename "$d")
        echo "=== $repo ==="
        just dev enable-extensions "$repo"
    done

# Ensure a fork exists for a repo and add as remote
[no-cd]
ensure-fork repo_name:
    #!/usr/bin/env bash
    set -eo pipefail
    cd "{{ root }}/dev/{{ repo_name }}"
    if ! git remote get-url fork &>/dev/null; then
        echo "Forking..."
        gh repo fork --remote --remote-name fork
        gh repo set-default "$(git remote get-url origin | sed 's|.*github.com[:/]||;s|\.git$||')"
    else
        echo "Fork remote already exists"
    fi

# Set up the venv: install --with packages, uv sync, enable extensions for all ./dev repos
[no-cd]
[arg("with_pkgs", long="with", help="comma-separated PyPI packages to add")]
setup with_pkgs="":
    #!/usr/bin/env bash
    set -eo pipefail
    root="{{ root }}"
    cd "$root"

    # Add --with PyPI packages without syncing yet
    IFS=',' read -ra pkgs <<< "{{ with_pkgs }}"
    [[ -z "${pkgs[0]}" ]] && pkgs=()
    if [[ ${#pkgs[@]} -gt 0 ]]; then
        uv add "${pkgs[@]}" --no-sync
    fi

    # Install everything in one pass (editable members + with-pkgs + base deps)
    uv sync

    # Enable extensions for every repo under ./dev
    just dev enable-all-extensions

# Install the jupyter-ai documentation build dependencies into the venv
[no-cd]
docs-deps:
    #!/usr/bin/env bash
    set -eo pipefail
    root="{{ root }}"
    jai="$root/dev/jupyter-ai"
    if [[ ! -d "$jai" ]]; then
        echo "Error: jupyter-ai is not dev-installed. Run 'just dev add jupyter-ai && uv sync' first." >&2
        exit 1
    fi
    echo "Installing docs build dependencies into the venv..."
    if grep -q '^docs = \[' "$jai/pyproject.toml" 2>/dev/null; then
        # Preferred: the `docs` extra is the single source of truth.
        uv pip install -e "$jai[docs]"
    else
        # Fallback for jupyter-ai checkouts predating the `docs` extra: the theme
        # + extensions live in docs/requirements.txt, which omits Sphinx itself.
        uv pip install sphinx -r "$jai/docs/requirements.txt"
    fi
    echo "✓ Docs dependencies installed"

# Preview subpackage docs in the aggregated jupyter-ai site (see skills/build-jupyter-ai-docs)
[no-cd]
build-jai-docs:
    #!/usr/bin/env bash
    set -eo pipefail
    root="{{ root }}"
    jai="$root/dev/jupyter-ai"

    if [[ ! -d "$jai" ]]; then
        echo "Error: jupyter-ai is not dev-installed. Run 'just dev add jupyter-ai && uv sync' first." >&2
        exit 1
    fi
    # Use the workspace venv's tools whether or not it is activated.
    [[ -d "$root/.venv/bin" ]] && export PATH="$root/.venv/bin:$PATH"
    if ! command -v sphinx-build &>/dev/null; then
        echo "Error: sphinx-build not found. Run 'just dev docs-deps' first." >&2
        exit 1
    fi

    manifest="$jai/submodules/manifest.json"
    if [[ ! -f "$manifest" ]]; then
        echo "Error: $manifest not found (is dev/jupyter-ai on a branch with the docs submodule infra?)" >&2
        exit 1
    fi

    # Repo slugs that are documentation submodules (submodules/<slug>).
    # (Plain while-read for bash 3.2 compatibility — no mapfile.)
    submodule_slugs=()
    while IFS= read -r slug; do
        [[ -n "$slug" ]] && submodule_slugs+=("$slug")
    done < <(jq -r 'to_entries[] | .value | split("/")[1]' "$manifest")

    # For each dev-installed repo that is also a doc submodule AND ships live
    # docs/, overlay its docs/ into the submodule working tree so the aggregation
    # hook picks up the *uncommitted* content. Track what we touched for cleanup.
    overlaid=()
    for slug in "${submodule_slugs[@]}"; do
        dev_docs="$root/dev/$slug/docs"
        sub_dir="$jai/submodules/$slug"
        [[ -d "$root/dev/$slug" && -d "$dev_docs" && -d "$sub_dir" ]] || continue
        overlaid+=("$slug")
    done

    # Guaranteed cleanup: restore every overlaid submodule to its pinned (sparse)
    # state and remove generated staging dirs, even if the build fails.
    cleanup() {
        for slug in "${overlaid[@]}"; do
            sub_dir="$jai/submodules/$slug"
            git -C "$sub_dir" checkout -- . 2>/dev/null || true
            git -C "$sub_dir" clean -ffdq 2>/dev/null || true
        done
        # Staging dirs the hook copies into docs/source/{contributors,developers}/<repo>/
        # are git-ignored; clean them so the tree is pristine after preview.
        for section in contributors developers; do
            for slug in "${submodule_slugs[@]}"; do
                rm -rf "$jai/docs/source/$section/$slug"
            done
        done
    }
    trap cleanup EXIT

    if [[ ${#overlaid[@]} -eq 0 ]]; then
        echo "Note: no dev-installed subpackage ships docs/ — building the base site only."
    else
        for slug in "${overlaid[@]}"; do
            echo "Overlaying live docs from dev/$slug → submodules/$slug/docs"
            mkdir -p "$jai/submodules/$slug/docs"
            cp -R "$root/dev/$slug/docs/." "$jai/submodules/$slug/docs/"
        done
    fi

    out="$jai/docs/_build/html"
    echo "Building docs → $out"
    sphinx-build -b html "$jai/docs/source" "$out"
    echo
    echo "✓ Docs built. Open: file://$out/index.html"

# Check out a repo branch under tmp/ (for reading without modifying repos/)
[no-cd]
checkout repo_name branch="main":
    #!/usr/bin/env bash
    set -eo pipefail
    root="{{ root }}"
    repo_name="{{ repo_name }}"
    branch="{{ branch }}"

    wb_repos="$(git rev-parse --path-format=absolute --git-common-dir | sed 's|/\.git$||')/repos"
    if [[ ! -d "$wb_repos/$repo_name" ]]; then
        url=$(jq -r --arg r "$repo_name" '.[$r].url // empty' "$root/repos.json")
        if [[ -z "$url" ]]; then
            echo "Error: '$repo_name' not found in repos.json" >&2
            exit 1
        fi
        git clone "$url" "$wb_repos/$repo_name"
    fi

    mkdir -p tmp
    dest="$root/tmp/$repo_name"
    if [[ -d "$dest" ]]; then
        echo "Switching $repo_name to $branch..."
        git -C "$dest" checkout "$branch"
    else
        ws_name=$(basename "$root")
        wt_branch="tmp-$ws_name/$repo_name"
        git -C "$wb_repos/$repo_name" fetch --all --prune
        git -C "$wb_repos/$repo_name" worktree add "$dest" "$branch" --detach 2>/dev/null \
            || git -C "$wb_repos/$repo_name" worktree add "$dest" -b "$wt_branch" "$branch"
    fi
    echo "✓ tmp/$repo_name checked out at $branch"
