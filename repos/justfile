checkout := justfile_directory()

# Clone/fetch all repos from repos.json (parallel, live status board)
# Env: REPOS_CLONE_JOBS = max concurrent git ops (default 8)
[no-cd]
clone:
    #!/usr/bin/env bash
    set -eo pipefail
    # The shared repos/ + repos.json live at the workbench ROOT and are shared
    # across all workspaces, so resolve the root from git — justfile_directory()
    # here would be the workspace when invoked from a worktree. Mirrors dev/ + ws.
    root="$(git rev-parse --path-format=absolute --git-common-dir | xargs dirname)"
    # Run this checkout's own copy of the script (a workspace tests its edits
    # against the shared repos/); {{ checkout }} is this checkout's root.
    exec bash "{{ checkout }}/scripts/repos-clone.sh" "$root"
